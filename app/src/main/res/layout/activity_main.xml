<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="#F8FAFC">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="CHECK TAG_RS" android:textStyle="bold" android:textSize="28sp" android:textColor="#101828" />
    <TextView android:id="@+id/step" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="1 / 3  SCAN STAND" android:textStyle="bold"
        android:textSize="24sp" android:textColor="#155EEF" />
    <TextView android:id="@+id/instruction" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="กดปุ่มสแกนด้านข้าง แล้วสแกน Stand"
        android:textSize="18sp" android:textColor="#344054" />

    <EditText android:id="@+id/scannerInput" android:layout_width="1dp" android:layout_height="1dp"
        android:singleLine="true" android:imeOptions="actionDone" android:inputType="textNoSuggestions"
        android:background="@android:color/transparent" android:textColor="@android:color/transparent" />

    <LinearLayout android:id="@+id/resultPanel" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" android:orientation="vertical"
        android:padding="16dp" android:background="#FFFFFF">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="รอการสแกน" android:textStyle="bold" android:textSize="32sp" android:textColor="#344054" />
        <TextView android:id="@+id/employeeName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="ผู้ตรวจ: —" android:textStyle="bold" android:textSize="20sp" android:textColor="#101828" />
        <TextView android:id="@+id/standPart" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="STAND\n—" android:textStyle="bold" android:textSize="22sp" android:textColor="#101828" />
        <TextView android:id="@+id/boxPart" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="BOX TAG\n—" android:textStyle="bold" android:textSize="22sp" android:textColor="#101828" />
        <TextView android:id="@+id/kanbanPart" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="KANBAN\n—" android:textStyle="bold" android:textSize="22sp" android:textColor="#101828" />
        <TextView android:id="@+id/difference" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textSize="18sp" android:textColor="#B42318" />
    </LinearLayout>

    <Button android:id="@+id/rawButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:text="ดู RAW DATA เต็ม" android:textSize="17sp" android:visibility="gone" />
    <Button android:id="@+id/boxDoneButton" android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginTop="8dp" android:text="BOX ครบ / เริ่มสแกน KANBAN" android:textSize="18sp" android:visibility="gone" />
    <Button android:id="@+id/rescanButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:text="สแกนรายการนี้ใหม่" android:textSize="17sp" android:visibility="gone" />
    <Button android:id="@+id/nextButton" android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginTop="8dp" android:text="เริ่มรอบใหม่ / รอสแกนพนักงาน" android:textSize="18sp" android:visibility="gone" />
    <Button android:id="@+id/clearButton" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="8dp" android:text="CLEAR LAST / ล้างรายการล่าสุด" android:textSize="16sp" />
    <Button android:id="@+id/historyButton" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="8dp" android:text="ประวัติ → เลือกรายการ → ดูรายละเอียด" android:textSize="15sp" />
    <Button android:id="@+id/exportButton" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="8dp" android:text="ส่ง CSV ผ่าน Outlook" android:textSize="16sp" />
</LinearLayout>
